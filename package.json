{
  "name": "lanchai-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "test:search": "node --import tsx --test tests/unit/search.test.ts",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test:unit": "node --import tsx --test \"tests/unit/**/*.test.ts\"",
    "test": "npm run test:unit && npm run test:emu",
    "test:rules": "rm -rf tests/.coverage && node --import tsx --test --test-concurrency=1 \"tests/rules/**/*.test.ts\" && tsx tests/rules/coverage.ts",
    "test:emu:rules": "firebase emulators:exec --config firebase.test.json --only firestore,storage --project demo-lanchai \"npm run test:rules\"",
    "test:emu:functions": "firebase emulators:exec --config firebase.test.json --only firestore,storage,auth --project demo-lanchai \"npm --prefix functions test\"",
    "test:emu": "firebase emulators:exec --config firebase.test.json --only firestore,storage,auth --project demo-lanchai \"npm run test:rules && npm --prefix functions test\""
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^17.0.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.8",
    "@sentry/react-native": "~7.2.0",
    "expo": "~54.0.37",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.11",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-media-library": "~18.2.1",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.23",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-video": "~3.0.16",
    "expo-video-thumbnails": "~10.0.8",
    "firebase": "^12.14.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "firebase-tools": "^15.24.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2"
  },
  "private": true
}
