rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// LANCHAI — Firebase Storage Security Rules
//
// Paths covered:
//   products/{productId}/{imageId}              — product listing photos
//   chat-images/{uid}/{fileName}                — renter↔admin chat photo attachments
//   chat-videos/{uid}/{fileName}                — renter↔admin chat video attachments
//   reservations/{reservationId}/{type}/{file}  — handover/return checklist photos
//   claim-photos/{uid}/{fileName}                — renter-submitted claim evidence photos
//   claim-videos/{uid}/{fileName}                — renter-submitted claim evidence videos
//   homeSlides/{slideId}/{fileName}             — Home hero / banner slide photos
//   collections/{collectionId}/{fileName}       — pack photos (Admin → Collections)
//   rentalAgreements/{agreementId}/{fileName}   — signed rental agreements (PDF)
//
// Admin detection mirrors firestore.rules exactly:
//   firestore.rules uses:  exists(/databases/$(database)/documents/admins/$(uid))
//   storage.rules uses:    firestore.exists(/databases/(default)/documents/admins/$(uid))
//
// The only difference is syntax: Storage rules must prefix `firestore.` and
// hard-code `(default)` (the Firestore database name) instead of `$(database)`,
// since the Storage rule evaluation context has no `$(database)` binding.
// The check is otherwise identical — a document must exist at admins/{uid}.
//
// READS: private files (chat, claims, profile photos, checklist photos) are readable
// via the SDK only by their owner (or staff). In Storage rules `read` includes LIST,
// so a looser rule let any signed-in user enumerate other people's files. Images
// already shown in the app keep working: they use download URLs with an access token,
// which aren't subject to these rules. Product photos stay public (deliberate).
//
// OVERWRITES: uploading to a path that already holds a file is evaluated as `create`
// (not `update`) — so "create once" paths must check `resource == null` explicitly.
// (Found by tests/rules/storage.test.ts, 2026-11-04.)
//
// DELETES: on a delete, request.resource is null, so a combined `write` rule with a
// size / contentType condition can never allow one. Each path therefore states its
// delete rule separately: admin-managed media (products, home slides) and the owner's
// own profile photo can be deleted; evidence (chat, claims, checklist photos, business
// documents) and ID documents (retention rules, server-side only) stay undeletable from the client on purpose — server code (Admin SDK,
// e.g. account deletion) is not subject to these rules.
// ─────────────────────────────────────────────────────────────────────────────

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // A REAL account (email / Google), not a guest's anonymous session — mirrors
    // firestore.rules isAccount(). Every renter upload requires it.
    function isAccount() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // The renter uploading into their own folder, with a real account.
    function isAccountOwner(uid) {
      return isAccount() && request.auth.uid == uid;
    }

    // ── Product images ────────────────────────────────────────────────────
    // Public read so product images display in the app without requiring auth.
    // Write is admin-only: authenticated + present in the admins collection.
    match /products/{productId}/{imageId} {
      allow read:  if true;
      allow create, update: if isAdmin()
                           && request.resource.size < 10 * 1024 * 1024
                           && request.resource.contentType.matches('image/.*');
      allow delete:         if isAdmin();
    }

    // ── Chat images ───────────────────────────────────────────────────────
    // Path: chat-images/{uid}/{fileName}  (uid = renterId; fileName = Date.now())
    //
    // Read: the owner (uid in the path) or an admin — see the READS note at the top.
    //
    // Write: the renter whose UID matches the path segment, OR any admin.
    //   The admin chat (app/admin-chat/[conversationId].tsx) calls
    //   uploadChatImage(conversationId, ...) where conversationId == renterId,
    //   so the admin's own UID != uid in the path — hence the isAdmin() branch.
    match /chat-images/{uid}/{fileName} {
      allow read:   if request.auth != null && (request.auth.uid == uid || isAdmin());
      // Create once (no overwrite of a sent file — evidence).
      allow create: if resource == null
                    && (isAccountOwner(uid) || isAdmin())
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow update: if false;
      allow delete: if false;  // evidence — see DELETES above
    }

    // ── Chat videos ───────────────────────────────────────────────────────
    // Path: chat-videos/{uid}/{fileName}  (uid = renterId; fileName = Date.now().mp4)
    // Same read/write rationale as chat-images above. Size cap is a hard backstop —
    // the client (lib/chat.ts's uploadChatVideo) already rejects gallery-picked
    // videos over 50MB before starting the upload; recorded videos are capped at
    // the source (60s max, medium quality) and stay well under this ceiling.
    match /chat-videos/{uid}/{fileName} {
      allow read:   if request.auth != null && (request.auth.uid == uid || isAdmin());
      // Create once (no overwrite of a sent file — evidence).
      allow create: if resource == null
                    && (isAccountOwner(uid) || isAdmin())
                    && request.resource.size < 60 * 1024 * 1024
                    && request.resource.contentType.matches('video/.*');
      allow update: if false;
      allow delete: if false;  // evidence — see DELETES above
    }

    // ── Rental checklist photos ───────────────────────────────────────────────
    // Path: reservations/{reservationId}/{checklistType}/{fileName}
    //   checklistType is 'handover' or 'return'; fileName is Date.now()-based.
    //
    // Read: admins only via the SDK (no uid in this path). Renters still see their
    // checklist photos through the stored download URLs — see the READS note at the top.
    // Write: admin only — condition photos are captured by staff, never by renters.
    match /reservations/{reservationId}/{checklistType}/{fileName} {
      allow read:  if isAdmin();
      // Create once — a condition photo is evidence: never replaced (each photo gets a
      // new Date.now() name).
      allow create: if resource == null
                    && isAdmin()
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow update: if false;
      allow delete: if false;  // condition evidence
    }

    // ── Rental agreements ─────────────────────────────────────────────────────
    // Path: rentalAgreements/{agreementId}/{fileName} — the signed PDF (or the PDF of
    // the paper form's photos). Business record: never deleted from the client, and NOT
    // touched by the ID-document retention job.
    // Read: admins, or the renter of that agreement (rentalAgreements/{id}.renterId —
    //   written by finalizeRentalAgreement right after the upload).
    // Write: admins only, create once (no overwrite).
    match /rentalAgreements/{agreementId}/{fileName} {
      allow read:   if isAdmin()
                    || (request.auth != null
                        && firestore.get(/databases/(default)/documents/rentalAgreements/$(agreementId)).data.renterId == request.auth.uid);
      allow create: if resource == null
                    && isAdmin()
                    && request.resource.size < 15 * 1024 * 1024
                    && (request.resource.contentType == 'application/pdf'
                        || request.resource.contentType.matches('image/.*'));
      allow update, delete: if false;
    }

    // ── Claim photos ──────────────────────────────────────────────────────────
    // Path: claim-photos/{uid}/{fileName}  (uid = the renter filing the claim;
    //   fileName = Date.now()_index.jpg — see lib/claims.ts's uploadClaimPhoto)
    //
    // Read: the owner (uid in the path) or an admin — see the READS note at the top.
    // Write: the renter whose UID matches the path segment only — unlike chat,
    //   there's no admin-uploads-on-a-renter's-behalf case here, so no isAdmin()
    //   branch is needed.
    match /claim-photos/{uid}/{fileName} {
      allow read:  if request.auth != null && (request.auth.uid == uid || isAdmin());
      // Create once (no overwrite — evidence).
      allow create: if resource == null
                    && isAccountOwner(uid)
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow update: if false;
      allow delete: if false;  // claim evidence
    }

    // ── Claim videos ──────────────────────────────────────────────────────────
    // Path: claim-videos/{uid}/{fileName}  (uid = the renter filing the claim;
    //   fileName = Date.now()_index.mp4 — see lib/claims.ts's uploadClaimVideo)
    // Same read/write rationale as claim-photos above — sibling path, not a unified
    // claim-media path, matching this file's existing chat-images/chat-videos
    // sibling precedent. 50MB cap matches lib/claims.ts's CLAIM_VIDEO_MAX_BYTES
    // exactly (a deliberately independent limit from chat-videos' 60MB).
    match /claim-videos/{uid}/{fileName} {
      allow read:  if request.auth != null && (request.auth.uid == uid || isAdmin());
      // Create once (no overwrite — evidence).
      allow create: if resource == null
                    && isAccountOwner(uid)
                    && request.resource.size < 50 * 1024 * 1024
                    && request.resource.contentType.matches('video/.*');
      allow update: if false;
      allow delete: if false;  // claim evidence
    }

    // ── Profile photos ────────────────────────────────────────────────────────
    // Path: profile-photos/{uid}/{fileName}
    //
    // Read: the owner (uid in the path) or an admin — see the READS note at the top.
    // Write: the user whose UID matches the path segment only.
    match /profile-photos/{uid}/{fileName} {
      allow read:  if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update: if isAccountOwner(uid)
                           && request.resource.size < 5 * 1024 * 1024
                           && request.resource.contentType.matches('image/.*');
      allow delete:         if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    // ── BtoB business registration documents ──────────────────────────────────
    // Path: businessDocs/{uid}/{fileName}
    //
    // Read: the owning user, OR any admin (admins must review the document to
    //   approve/reject the application).
    // Write: the user whose UID matches the path segment only. Create once — a new
    //   document is a NEW file (Date.now() name); the one an admin reviewed is never
    //   overwritten.
    match /businessDocs/{uid}/{fileName} {
      allow read:   if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if resource == null
                    && isAccountOwner(uid)
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow update: if false;
      allow delete: if false;  // review evidence
    }

    // ── Identity / residency documents (very sensitive) ───────────────────────
    // Path: idDocs/{uid}/{fileName} — the renter's ID document photos (and, later,
    // residency documents). Read: the owner or an admin only (never public; the app
    // never stores download URLs — paths only). Create: the owner (real account), or an
    // admin photographing the ID at the counter. Images only, < 10 MB. No overwrite.
    // Delete: NEVER from the client — the retention rules (functions/src/shared/
    // retention.ts) decide when a document may go; deleteMyIdentityDocument /
    // withdrawResidency / documentRetentionDaily delete through the Admin SDK.
    match /idDocs/{uid}/{fileName} {
      allow read:   if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if resource == null
                    && (isAccountOwner(uid) || isAdmin())
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow update: if false;
      allow delete: if false;
    }

    // ── Home slides (hero carousel + mid-page banner) ─────────────────────
    // Path: homeSlides/{slideId}/{fileName}. Read: signed-in users (the Home is behind
    // sign-in). Write: admins only (Admin → Home slides), images < 10 MB.
    match /homeSlides/{slideId}/{fileName} {
      allow read:           if request.auth != null;
      allow create, update: if isAdmin()
                            && request.resource.size < 10 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
      allow delete:         if isAdmin();
    }

    // ── Pack photos (Admin → Collections, isPack) ─────────────────────────
    // Path: collections/{collectionId}/{fileName}. Read: any session (guests are an
    // anonymous session). Write: admins only, images < 10 MB.
    match /collections/{collectionId}/{fileName} {
      allow read:           if request.auth != null;
      allow create, update: if isAdmin()
                            && request.resource.size < 10 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
      allow delete:         if isAdmin();
    }

    // ── Onboarding photos (Admin → Onboarding, 3 portrait slots) ──────────
    // Path: onboarding/{slot}/{fileName}. Read: any session (guests are an anonymous
    // session). Write: admins only, images < 10 MB.
    match /onboarding/{slot}/{fileName} {
      allow read:           if request.auth != null;
      allow create, update: if isAdmin()
                            && request.resource.size < 10 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
      allow delete:         if isAdmin();
    }

    // Default deny for everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
